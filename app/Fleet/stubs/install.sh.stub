#!/bin/bash
# GasMonitor installer — warehouse {{WAREHOUSE_CODE}} — generated by fleet server. Idempotent: safe to re-run.
set -euo pipefail
FLEET_API='{{FLEET_API}}'; API_KEY='{{API_KEY}}'; WH='{{WAREHOUSE_CODE}}'
REL_ID='{{RELEASE_ID}}'; VERSION='{{VERSION}}'; SHA256='{{SHA256}}'; PUBKEY='{{PUBLIC_KEY}}'
CLOUD_API='{{CLOUD_API}}'
[ "$(id -u)" = 0 ] || { echo "run as root: sudo bash"; exit 1; }

# reuse existing install dir/user if a gasmonitor unit exists
DIR="${INSTALL_DIR:-}"; RUNUSER="${RUN_USER:-}"
if [ -f /etc/systemd/system/gasmonitor.service ]; then
  [ -z "$DIR" ] && DIR=$(sed -n 's/^WorkingDirectory=//p' /etc/systemd/system/gasmonitor.service | head -1)
  [ -z "$RUNUSER" ] && RUNUSER=$(sed -n 's/^User=//p' /etc/systemd/system/gasmonitor.service | head -1)
fi
DIR="${DIR:-/opt/gasmonitor}"; RUNUSER="${RUNUSER:-${SUDO_USER:-root}}"
echo "install dir: $DIR  user: $RUNUSER  warehouse: $WH  version: $VERSION"
mkdir -p "$DIR"

TMP=$(mktemp); trap 'rm -f "$TMP"' EXIT
curl -fsSL -H "X-API-Key: $API_KEY" "$FLEET_API/releases/$REL_ID/download" -o "$TMP"
echo "$SHA256  $TMP" | sha256sum -c - >/dev/null || { echo "sha256 mismatch"; exit 1; }
[ -f "$DIR/gasmonitor" ] && cp -f "$DIR/gasmonitor" "$DIR/gasmonitor.bak"
install -m 0755 "$TMP" "$DIR/gasmonitor"

cat > "$DIR/run.sh" <<'RUNSH'
{{RUN_SH}}
RUNSH
chmod 0755 "$DIR/run.sh"

setenvkv() { # key value  (adds or replaces in .env)
  touch "$DIR/.env"
  if grep -q "^$1=" "$DIR/.env"; then sed -i "s|^$1=.*|$1=$2|" "$DIR/.env"; else echo "$1=$2" >> "$DIR/.env"; fi
}
[ -f "$DIR/.env" ] && cp -f "$DIR/.env" "$DIR/.env.bak"
[ -n "$CLOUD_API" ] && ! grep -q '^CLOUD_API=' "$DIR/.env" 2>/dev/null && setenvkv CLOUD_API "$CLOUD_API"
grep -q '^CLOUD_API_KEY=' "$DIR/.env" 2>/dev/null || setenvkv CLOUD_API_KEY "$API_KEY"
setenvkv WAREHOUSE_CODE "$WH"
setenvkv CENTRAL_API "$FLEET_API"
setenvkv CENTRAL_API_KEY "$API_KEY"
setenvkv AUTO_UPDATE 1
[ -n "$PUBKEY" ] && setenvkv UPDATE_PUBLIC_KEY "$PUBKEY"
chown -R "$RUNUSER" "$DIR" 2>/dev/null || true

if [ "${SKIP_SYSTEMD:-0}" != 1 ]; then
cat > /etc/systemd/system/gasmonitor.service <<UNIT
[Unit]
Description=GasMonitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=$RUNUSER
WorkingDirectory=$DIR
ExecStart=$DIR/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload; systemctl enable gasmonitor >/dev/null 2>&1; systemctl restart gasmonitor
  echo "started. Approve this workstation in the Fleet dashboard."
else
  echo "SKIP_SYSTEMD=1: files placed, service not touched"
fi
