#!/bin/bash
# GasMonitor installer — warehouse {{WAREHOUSE_CODE}} — generated by Workstation Manager.
# Idempotent: safe to re-run. Refuses to install anything whose Ed25519 signature does not verify.
set -euo pipefail
AGENT_API='{{AGENT_API}}'; ENROLL_KEY='{{ENROLL_KEY}}'; WH='{{WAREHOUSE_CODE}}'
REL_ID='{{RELEASE_ID}}'; VERSION='{{VERSION}}'; SHA256='{{SHA256}}'; SIGNATURE='{{SIGNATURE}}'
TYPE='{{TYPE}}'; PUBKEY='{{PUBLIC_KEY}}'; CLOUD_API='{{CLOUD_API}}'
SERVICE=gasmonitor

say()  { echo -e "\033[1;32m==>\033[0m $*"; }
die()  { echo -e "\033[1;31mERROR:\033[0m $*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "root se chalayein:  ... | sudo bash"
for c in curl sha256sum openssl base64 install; do command -v "$c" >/dev/null || die "'$c' install nahi hai"; done
[ -n "$PUBKEY" ] || die "server par signing key set nahi hai"

# reuse existing install dir/user if the service already exists
DIR="${INSTALL_DIR:-}"; RUNUSER="${RUN_USER:-}"
UNIT=/etc/systemd/system/$SERVICE.service
if [ -f "$UNIT" ]; then
  [ -z "$DIR" ] && DIR=$(sed -n 's/^WorkingDirectory=//p' "$UNIT" | head -1)
  [ -z "$RUNUSER" ] && RUNUSER=$(sed -n 's/^User=//p' "$UNIT" | head -1)
fi
DIR="${DIR:-/opt/gasmonitor}"; RUNUSER="${RUNUSER:-${SUDO_USER:-root}}"
say "install dir: $DIR   user: $RUNUSER   warehouse: $WH   version: $VERSION ($TYPE)"
mkdir -p "$DIR"

WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
say "release download ho raha hai..."
curl -fsSL -H "X-API-Key: $ENROLL_KEY" "$AGENT_API/releases/$REL_ID/download" -o "$WORK/pkg"

say "sha256 check..."
echo "$SHA256  $WORK/pkg" | sha256sum -c - >/dev/null || die "sha256 match nahi hua — file kharab ya badli hui hai"

say "Ed25519 signature check..."
# raw 32-byte Ed25519 key -> SubjectPublicKeyInfo PEM (DER prefix 302a300506032b6570032100)
{ printf '\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00'; echo "$PUBKEY" | base64 -d; } > "$WORK/pub.der"
openssl pkey -pubin -inform DER -in "$WORK/pub.der" -out "$WORK/pub.pem" 2>/dev/null || die "public key galat hai"
printf '%s' "gasmonitor|$VERSION|$SHA256" > "$WORK/msg"
echo "$SIGNATURE" | base64 -d > "$WORK/sig" 2>/dev/null || die "signature galat format mein hai"
openssl pkeyutl -verify -pubin -inkey "$WORK/pub.pem" -rawin -in "$WORK/msg" -sigfile "$WORK/sig" >/dev/null 2>&1 \
  || die "signature verify nahi hua (OpenSSL 3 chahiye) — install rok diya"

if [ "$TYPE" = "package" ]; then
  say "package extract ho raha hai..."
  [ -d "$DIR/current" ] && rm -rf "$DIR/previous" && mv "$DIR/current" "$DIR/previous"
  mkdir -p "$DIR/current"
  tar -xzf "$WORK/pkg" -C "$DIR/current" --no-same-owner
  chown -R "$RUNUSER" "$DIR/current" 2>/dev/null || true
  POST_UPDATE=$(cat <<'POSTUPDATE'
{{POST_UPDATE}}
POSTUPDATE
)
  if [ -n "$POST_UPDATE" ]; then
    say "post-update steps chal rahe hain..."
    ( cd "$DIR/current" && while IFS= read -r line; do [ -n "$line" ] && eval "$line"; done <<< "$POST_UPDATE" ) \
      || die "post-update step fail hua"
  fi
  say "package v$VERSION install ho gaya: $DIR/current"
  exit 0
fi

[ -f "$DIR/gasmonitor" ] && cp -f "$DIR/gasmonitor" "$DIR/gasmonitor.bak"
install -m 0755 "$WORK/pkg" "$DIR/gasmonitor"

cat > "$DIR/run.sh" <<'RUNSH'
{{RUN_SH}}
RUNSH
chmod 0755 "$DIR/run.sh"

setenvkv() { # key value  (adds or replaces in .env)
  touch "$DIR/.env"
  if grep -q "^$1=" "$DIR/.env"; then
    local esc; esc=$(printf '%s' "$2" | sed 's/[|&\\]/\\&/g')
    sed -i "s|^$1=.*|$1=$esc|" "$DIR/.env"
  else
    printf '%s=%s\n' "$1" "$2" >> "$DIR/.env"
  fi
}
[ -f "$DIR/.env" ] && cp -f "$DIR/.env" "$DIR/.env.bak"
grep -q '^CLOUD_API=' "$DIR/.env" 2>/dev/null || setenvkv CLOUD_API "$CLOUD_API"
setenvkv WAREHOUSE_CODE "$WH"
setenvkv CENTRAL_API "$AGENT_API"
setenvkv CENTRAL_API_KEY "$ENROLL_KEY"
setenvkv AUTO_UPDATE 1
setenvkv UPDATE_PUBLIC_KEY "$PUBKEY"
setenvkv REQUIRE_SIGNED_UPDATES 1
chmod 600 "$DIR/.env"
chown -R "$RUNUSER" "$DIR" 2>/dev/null || true

if [ "${SKIP_SYSTEMD:-0}" != 1 ]; then
cat > "$UNIT" <<UNITFILE
[Unit]
Description=GasMonitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=$RUNUSER
WorkingDirectory=$DIR
ExecStart=$DIR/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNITFILE
  systemctl daemon-reload
  systemctl enable "$SERVICE" >/dev/null 2>&1
  systemctl restart "$SERVICE"
  say "GasMonitor chal raha hai. Ab Workstation Manager mein jaakar is workstation ko Approve karein."
else
  say "SKIP_SYSTEMD=1: files rakh di, service ko chhua nahi"
fi
